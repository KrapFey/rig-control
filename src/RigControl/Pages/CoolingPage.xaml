<Page
    x:Class="RigControl.Pages.CoolingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    xmlns:p="using:RigControl.Pages"
    xmlns:c="using:RigControl.Controls"
    Background="Transparent">

    <Page.Resources>
        <!-- One fan in a curve's card: drag it onto another card to make it follow that curve -->
        <DataTemplate x:Key="FanRow" x:DataType="local:FanVm">
            <Grid Padding="0,6" ColumnSpacing="8" Opacity="{x:Bind local:Fmt.PresentOpacity(Present), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:FanGlyph Width="20" Height="20" Rpm="{x:Bind Rpm.Value, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"
                          Visibility="{x:Bind local:Fmt.ShowText(Error), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}" />
                <TextBlock Grid.Column="3" Text="{x:Bind local:Fmt.Duty(Duty.Value, DutyKnown), Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- A curve and the fans that follow it (or the fans on no curve) -->
        <DataTemplate x:Key="GroupCard" x:DataType="p:CurveGroup">
            <Border Style="{StaticResource Card}" Padding="6" BorderBrush="{x:Bind Stroke, Mode=OneWay}" BorderThickness="{x:Bind StrokeThickness, Mode=OneWay}"
                    AllowDrop="True" DragOver="Group_DragOver" Drop="Group_Drop" DataContext="{x:Bind}">
                <StackPanel>
                    <Button Style="{StaticResource TileButton}" Click="Group_Click" DataContext="{x:Bind}" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Padding="0">
                        <Grid Padding="8,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource AccentGradient}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Output, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                    <ListView ItemsSource="{x:Bind Members}" ItemTemplate="{StaticResource FanRow}" SelectionMode="Single" IsItemClickEnabled="True"
                              CanDragItems="True" DragItemsStarting="Fans_DragItemsStarting" ItemClick="Fan_ItemClick" Loaded="Fans_Loaded"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    <TextBlock Text="{x:Bind EmptyHint, Mode=OneWay}" Style="{StaticResource Caption}" Margin="10,2,10,8" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Fmt.ShowText(EmptyHint), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The selected fan's own settings -->
        <DataTemplate x:Key="FanPanel" x:DataType="p:FanEdit">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <c:FanGlyph Width="44" Height="44" Rpm="{x:Bind Live.Rpm.Value, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Live.Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Live.Device}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock>
                        <Run Text="{x:Bind local:Fmt.Int(Live.Rpm.Value), Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /><Run Text=" rpm" Foreground="{StaticResource Muted}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{x:Bind local:Fmt.Duty(Live.Duty.Value, Live.DutyKnown), Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Live.Mode, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{x:Bind Live.Error, Mode=OneWay}" Foreground="{StaticResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind local:Fmt.ShowText(Live.Error), Mode=OneWay}" />

                <TextBox Header="Name" Text="{x:Bind Name, Mode=TwoWay}" PlaceholderText="{x:Bind Live.Channel.Name}" />
                <ToggleSwitch Header="Controlled by RigControl" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                <ComboBox Header="Follows" HorizontalAlignment="Stretch" ItemsSource="{x:Bind CurveNames}" SelectedItem="{x:Bind Curve, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                <ToggleSwitch Header="Fixed speed instead" IsOn="{x:Bind ManualOn, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                <Slider Header="{x:Bind local:Fmt.Percent(ManualValue), Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind ManualValue, Mode=TwoWay}"
                        Visibility="{x:Bind local:Fmt.Show(ManualOn), Mode=OneWay}" />

                <TextBlock Text="LIMITS" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <NumberBox Header="Minimum %" Value="{x:Bind Min, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Column="1" Header="Start %" Value="{x:Bind Start, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Spin-up kick: at least this when starting from 0" />
                    <NumberBox Grid.Row="1" Header="Stop %" Value="{x:Bind Stop, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Below this the fan stops; 0 = never" />
                    <NumberBox Grid.Row="2" Header="Step up %" Value="{x:Bind StepUp, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Most it speeds up per tick" />
                    <NumberBox Grid.Row="2" Grid.Column="1" Header="Step down %" Value="{x:Bind StepDown, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Most it slows down per tick" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="Identify" Click="{x:Bind Identify}" ToolTipService.ToolTip="Stops this fan for 8 seconds so you can spot it (a pump runs at full speed instead)" />
                    <DropDownButton Content="Swap with…" ToolTipService.ToolTip="Exchange name, curve and settings with another fan (fixes mixed-up identical controllers)">
                        <DropDownButton.Flyout>
                            <MenuFlyout Opening="SwapMenu_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition />
            <ColumnDefinition x:Name="FanColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3">
            <StackPanel>
                <TextBlock Text="Cooling" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock Text="Curves turn temperatures into fan speeds. Drag a fan onto a curve to make it follow, or click it for its settings." Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Rescan_Click" AutomationProperties.Name="Rescan"
                    ToolTipService.ToolTip="Look for fans and sensors again. Fans go back to their own control for the few seconds this takes.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Curves with their fans -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <ItemsRepeater x:Name="Groups" ItemTemplate="{StaticResource GroupCard}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <DropDownButton Content="New curve">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Graph (temperature → %)" Tag="Graph" Click="New_Click" />
                            <MenuFlyoutItem Text="Mix (combine curves)" Tag="Mix" Click="New_Click" />
                            <MenuFlyoutItem Text="Flat (fixed %)" Tag="Flat" Click="New_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="DeleteButton" Click="Delete_Click" ToolTipService.ToolTip="Delete curve" AutomationProperties.Name="Delete curve">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button x:Name="UndoButton" IsEnabled="False" Click="Undo_Click" AutomationProperties.Name="Undo"
                        ToolTipService.ToolTip="Undo the last change to the curve's points">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The selected curve -->
        <Border x:Name="EditorCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="22">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16" SizeChanged="EditorHeader_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Header="Name" LostFocus="NameBox_LostFocus" />
                    <ComboBox x:Name="SourceBox" Grid.Column="1" Header="Temperature" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="SourceBox_SelectionChanged" />
                    <NumberBox x:Name="DeadbandBox" Grid.Column="2" Header="Deadband °C" Minimum="0" Maximum="20" SpinButtonPlacementMode="Compact" ValueChanged="Tuning_ValueChanged" ToolTipService.ToolTip="Ignore temperature changes smaller than this" />
                    <NumberBox x:Name="ResponseBox" Grid.Column="3" Header="Response s" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact" ValueChanged="Tuning_ValueChanged" ToolTipService.ToolTip="A change must last this long before fans react" />
                    <ComboBox x:Name="MixBox" Grid.Column="1" Header="Combine with" HorizontalAlignment="Stretch" SelectionChanged="MixBox_SelectionChanged" Visibility="Collapsed">
                        <x:String>Max</x:String>
                        <x:String>Min</x:String>
                        <x:String>Average</x:String>
                    </ComboBox>
                </Grid>

                <c:CurveEditor x:Name="Editor" Grid.Row="1" />

                <StackPanel x:Name="MixPanel" Grid.Row="1" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="INPUT CURVES" Style="{StaticResource Caption}" />
                    <ItemsControl x:Name="MixInputs" />
                </StackPanel>

                <StackPanel x:Name="FlatPanel" Grid.Row="1" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="FlatText" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource AccentGradient}" />
                    <Slider x:Name="FlatSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="FlatSlider_ValueChanged" />
                </StackPanel>

                <StackPanel x:Name="Empty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE9D9;" FontSize="40" Opacity="0.5" />
                    <TextBlock Text="No curves yet. Create one, or bring over your FanControl setup." Opacity="0.7" HorizontalAlignment="Center" />
                    <Button x:Name="ImportButton" Content="Import FanControl setup" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The selected fan -->
        <Border x:Name="FanCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <ContentControl x:Name="FanHost" ContentTemplate="{StaticResource FanPanel}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,28,0,0" />
                </ScrollViewer>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseFan_Click" Padding="6" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Close fan settings" ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
