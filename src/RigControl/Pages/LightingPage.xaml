<Page
    x:Class="RigControl.Pages.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:RigControl.Pages"
    xmlns:local="using:RigControl"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Header: title, profiles, master switch -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Lighting" Style="{StaticResource PageTitle}" Margin="0" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="RescanButton" Click="Rescan_Click" ToolTipService.ToolTip="Look for devices again (one plugged in or woken up since RigControl started)" AutomationProperties.Name="Rescan">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="RescanText" Text="Rescan" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="ProfileBox" Width="190" SelectionChanged="ProfileBox_SelectionChanged" />
                    <Button ToolTipService.ToolTip="Profile actions">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="New profile (copy of this one)" Click="NewProfile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Rename…" Click="RenameProfile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DeleteProfileItem" Text="Delete" Click="DeleteProfile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="2" OnContent="Lighting on" OffContent="Lighting off" VerticalAlignment="Center" Toggled="EnabledSwitch_Toggled" />
            </Grid>

            <InfoBar x:Name="Notice" Severity="Informational" IsClosable="False" />

            <!-- Synced effect -->
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="SYNCED EFFECT" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SyncCount" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <local:EffectEditor x:Name="Editor" Synced="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="DEVICES · CLICK ONE FOR ITS SETTINGS" Style="{StaticResource Caption}" Margin="2,4,0,0" />

            <ItemsRepeater x:Name="DeviceGrid">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="330" MinItemHeight="150" MinRowSpacing="14" MinColumnSpacing="14" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="p:DeviceCard">
                        <!-- ItemsRepeater doesn't set DataContext on its items; the handlers need it -->
                        <Border Style="{StaticResource Card}" Padding="18" DataContext="{x:Bind}" Tapped="Card_Tapped">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1AFFFFFF">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="Identify_Click" AutomationProperties.Name="Identify" ToolTipService.ToolTip="Identify: pulses this device white for 4 seconds" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                    </Button>
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Live LED strip with a soft glow -->
                                <Grid Height="22">
                                    <Border Background="{x:Bind Preview}" CornerRadius="11" Opacity="0.4" Margin="6,6,6,-4" />
                                    <Border Background="{x:Bind Preview}" CornerRadius="8" Margin="0,2" BorderBrush="#26FFFFFF" BorderThickness="1" />
                                </Grid>

                                <TextBlock Text="{x:Bind Shows, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
