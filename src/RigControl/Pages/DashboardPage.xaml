<Page
    x:Class="RigControl.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    xmlns:c="using:RigControl.Controls"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="Notices" Spacing="8" />

            <!-- Hero gauges -->
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" x:Name="CpuCard">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <c:Gauge x:Name="CpuGauge" Label="CPU" />
                        <TextBlock x:Name="CpuName" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" x:Name="GpuCard">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <c:Gauge x:Name="GpuGauge" Label="GPU" />
                        <TextBlock x:Name="GpuName" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" x:Name="AirCard">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <c:Gauge x:Name="AirGauge" Label="Airflow" Unit="%" />
                        <TextBlock x:Name="AirText" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="FANS" Style="{StaticResource Caption}" Margin="2,8,0,0" />

<ItemsRepeater x:Name="FanGrid" ElementPrepared="FanGrid_ElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="252" MinItemHeight="132" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:FanVm">
                        <Border
                            Height="132"
                            Tapped="Tile_Tapped"
                            Style="{StaticResource Card}"
                            Padding="16"
                            Opacity="{x:Bind local:Fmt.PresentOpacity(Present), Mode=OneWay}"
                            PointerEntered="Tile_PointerEntered"
                            PointerExited="Tile_PointerExited">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <c:FanGlyph Rpm="{x:Bind Rpm.Value, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Device}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="6">
                                    <TextBlock Text="{x:Bind local:Fmt.Int(Rpm.Value), Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="rpm" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                    <TextBlock Text="{x:Bind local:Fmt.Duty(Duty.Value, DutyKnown), Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,5" />
                                </StackPanel>
                                <Grid Grid.Row="2" Height="4" CornerRadius="2" Background="#1AFFFFFF">
                                    <Border CornerRadius="2" Background="{StaticResource AccentGradient}" HorizontalAlignment="Stretch">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{x:Bind local:Fmt.Fraction(Duty.Value), Mode=OneWay}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
