<Page
    x:Class="RigControl.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:RigControl.Pages"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="FullCard" x:DataType="p:PeripheralCard">
                            <StackPanel Spacing="22">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentGradient}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="30" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource PageTitle}" Margin="0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Source}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="14" Padding="12,6" Background="#1AFFFFFF" VerticalAlignment="Center" Visibility="{x:Bind BatteryVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind BatteryGlyph, Mode=OneWay}" FontSize="16" />
                                            <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF" />

                                <!-- Headset -->
                                <StackPanel Spacing="12" Visibility="{x:Bind HeadsetVisibility}">
                                    <InfoBar IsOpen="{x:Bind HeadsetOff, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                             Message="The headset is off or out of range. Settings apply when it's back." />
                                    <StackPanel Spacing="4" Visibility="{x:Bind ChatmixVisibility}">
                                        <Grid>
                                            <TextBlock Text="CHAT-MIX · set with the headset's dial" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{x:Bind ChatmixText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="128" Value="{x:Bind ChatmixValue, Mode=OneWay}" />
                                    </StackPanel>
                                    <Slider Header="{x:Bind SidetoneText, Mode=OneWay}" Minimum="0" Maximum="128" StepFrequency="1" Value="{x:Bind SidetoneValue, Mode=OneWay}"
                                            Tag="sidetone" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind SidetoneVisibility}" />
                                    <Slider Header="{x:Bind MicVolumeText, Mode=OneWay}" Minimum="0" Maximum="128" StepFrequency="1" Value="{x:Bind MicVolumeValue, Mode=OneWay}"
                                            Tag="micvolume" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind MicVolumeVisibility}" />
                                    <Slider Header="{x:Bind InactiveText, Mode=OneWay}" Minimum="0" Maximum="90" StepFrequency="5" Value="{x:Bind InactiveValue, Mode=OneWay}"
                                            Tag="inactive" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind InactiveVisibility}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Header="EQ preset" PlaceholderText="Choose… (the headset doesn't report it)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind EqOptions}" SelectedIndex="{x:Bind EqIndex, Mode=OneWay}"
                                                  Tag="eq" SelectionChanged="HeadsetCombo_SelectionChanged" Visibility="{x:Bind EqVisibility}" />
                                        <ComboBox Grid.Column="1" Header="Noise cancelling" PlaceholderText="Choose…" HorizontalAlignment="Stretch" ItemsSource="{x:Bind AncOptions}" SelectedIndex="{x:Bind AncIndex, Mode=OneWay}"
                                                  Tag="anc" SelectionChanged="HeadsetCombo_SelectionChanged" Visibility="{x:Bind AncVisibility}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <ToggleSwitch Header="Lights" IsOn="{x:Bind LightsOn, Mode=OneWay}" Tag="lights" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind LightsVisibility}" />
                                        <ToggleSwitch Header="Voice prompts" IsOn="{x:Bind VoicePromptsOn, Mode=OneWay}" Tag="voice" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind VoiceVisibility}" />
                                        <ToggleSwitch Header="Rotate to mute" IsOn="{x:Bind RotateOn, Mode=OneWay}" Tag="rotate" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind RotateVisibility}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- On-board lighting (VIA keyboards) -->
                                <StackPanel Spacing="10" Visibility="{x:Bind LightingVisibility}">
                                    <TextBlock Text="{x:Bind LightingTitle}" Style="{StaticResource Caption}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind LightEffectVisibility}">
                                        <Button Width="40" Height="34" Padding="0" Click="{x:Bind EffectPrev}" ToolTipService.ToolTip="Previous effect"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                                        <TextBlock Text="{x:Bind LightEffectText, Mode=OneWay}" MinWidth="90" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button Width="40" Height="34" Padding="0" Click="{x:Bind EffectNext}" ToolTipService.ToolTip="Next effect"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                                        <TextBlock Text="Effects are numbered by the keyboard's firmware" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Slider Header="{x:Bind LightBrightnessText, Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind LightBrightnessValue, Mode=OneWay}" Tag="lbright" ValueChanged="Slider_ValueChanged" />
                                        <Slider Grid.Column="1" Header="{x:Bind LightSpeedText, Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind LightSpeedValue, Mode=OneWay}" Tag="lspeed" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind LightSpeedVisibility}" />
                                    </Grid>
                                    <Grid ColumnSpacing="20" Visibility="{x:Bind LightColorVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="{x:Bind LightSwatch, Mode=OneWay}" VerticalAlignment="Bottom" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <StackPanel Grid.Column="1">
                                            <Slider Header="Colour" Minimum="0" Maximum="255" StepFrequency="1" Value="{x:Bind LightHueValue, Mode=OneWay}" IsThumbToolTipEnabled="False" Tag="lhue" ValueChanged="Slider_ValueChanged" />
                                            <Border Height="4" CornerRadius="2" Margin="0,-6,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#FF0000" /><GradientStop Offset="0.17" Color="#FFFF00" /><GradientStop Offset="0.33" Color="#00FF00" />
                                                        <GradientStop Offset="0.5" Color="#00FFFF" /><GradientStop Offset="0.67" Color="#0000FF" /><GradientStop Offset="0.83" Color="#FF00FF" /><GradientStop Offset="1" Color="#FF0000" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </StackPanel>
                                        <Slider Grid.Column="2" Header="{x:Bind LightSatText, Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind LightSatValue, Mode=OneWay}" Tag="lsat" ValueChanged="Slider_ValueChanged" />
                                    </Grid>
                                    <TextBlock Text="Set live: the keyboard's saved lighting stays as it is, and RigControl applies this again whenever the keyboard connects." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Keyboard switches -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ActuationVisibility}">
                                    <Slider Header="{x:Bind ActuationText, Mode=OneWay}" Minimum="0" Maximum="{x:Bind ActuationMax}" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight"
                                            Value="{x:Bind ActuationIndex, Mode=OneWay}" IsThumbToolTipEnabled="False" Tag="actuation" ValueChanged="Slider_ValueChanged" />
                                    <Grid>
                                        <TextBlock Text="Shallow · fast" Style="{StaticResource Caption}" />
                                        <TextBlock Text="Deep · fewer mistypes" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind ActuationNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <ToggleSwitch Header="Rapid trigger (a key resets as soon as it starts coming back up)" IsOn="{x:Bind RapidOn, Mode=OneWay}"
                                                  Tag="rapid" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind RapidVisibility}" />
                                </StackPanel>

                                <!-- Keyboard modes (Razer) -->
                                <StackPanel Orientation="Horizontal" Spacing="40" Visibility="{x:Bind KeyboardSwitchesVisibility}">
                                    <ToggleSwitch Header="Game mode (locks the Windows key, like Fn+F10)" IsOn="{x:Bind GameModeOn, Mode=OneWay}"
                                                  Tag="gamemode" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind GameModeVisibility}" />
                                    <ToggleSwitch Header="Switch optimisation" IsOn="{x:Bind KeyswitchGaming, Mode=OneWay}" OnContent="Gaming" OffContent="Typing"
                                                  Tag="keyswitch" Toggled="HeadsetToggle_Toggled" Visibility="{x:Bind KeyswitchVisibility}" />
                                </StackPanel>

                                <!-- DPI: type it, step it, pick a preset, or drag for big jumps -->
                                <StackPanel Spacing="10" Visibility="{x:Bind DpiVisibility}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DPI" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Width="44" Height="42" Padding="0" Click="{x:Bind StepDown}" ToolTipService.ToolTip="−50 DPI">
                                            <FontIcon Glyph="&#xE949;" FontSize="12" />
                                        </Button>
                                        <NumberBox Grid.Column="2" Width="140" Minimum="{x:Bind DpiMin}" Maximum="{x:Bind DpiMax}" Value="{x:Bind Dpi, Mode=OneWay}"
                                                   SmallChange="50" LargeChange="400" SpinButtonPlacementMode="Hidden" FontSize="22" FontWeight="SemiBold"
                                                   ValueChanged="Dpi_NumberChanged" GotFocus="Number_GotFocus" ToolTipService.ToolTip="Type a DPI and press Enter" />
                                        <Button Grid.Column="3" Width="44" Height="42" Padding="0" Click="{x:Bind StepUp}" ToolTipService.ToolTip="+50 DPI">
                                            <FontIcon Glyph="&#xE948;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:DpiPreset">
                                                <Button Content="{x:Bind Label}" Click="{x:Bind Pick}" Padding="10,4" MinWidth="0" CornerRadius="12"
                                                        Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{StaticResource CardStroke}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Slider Minimum="{x:Bind DpiMin}" Maximum="{x:Bind DpiMax}" StepFrequency="50" Value="{x:Bind Dpi, Mode=OneWay}" IsThumbToolTipEnabled="False" Tag="dpi" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>

                                <!-- DPI stages -->
                                <StackPanel Spacing="6" Visibility="{x:Bind StagesVisibility}">
                                    <TextBlock Text="{x:Bind StagesTitle}" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{x:Bind Stages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:StageVm">
                                                <StackPanel Spacing="4">
                                                    <RadioButton GroupName="{x:Bind Group}" IsChecked="{x:Bind Active, Mode=OneWay}" Content="{x:Bind Label}" MinWidth="0" Checked="Stage_Checked" IsEnabled="{x:Bind Selectable}" />
                                                    <NumberBox Minimum="100" Maximum="{x:Bind Max}" Value="{x:Bind Value, Mode=OneWay}" ValueChanged="Stage_ValueChanged" GotFocus="Number_GotFocus" SmallChange="50" LargeChange="400" Width="120" SpinButtonPlacementMode="Hidden" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Polling rate -->
                                <StackPanel Spacing="4" Visibility="{x:Bind PollVisibility}">
                                    <TextBlock Text="POLLING RATE" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Bind PollOptions}" SelectedIndex="{x:Bind PollIndex, Mode=OneWay}" MinWidth="160" SelectionChanged="Poll_SelectionChanged" />
                                </StackPanel>

                                <!-- Power -->
                                <Grid ColumnSpacing="20" Visibility="{x:Bind PowerVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Slider Header="{x:Bind SleepText, Mode=OneWay}" Minimum="1" Maximum="15" StepFrequency="1" Value="{x:Bind SleepMinutes, Mode=OneWay}" Tag="sleep" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind SleepVisibility}" />
                                    <Slider Grid.Column="1" Header="{x:Bind LowBatteryText, Mode=OneWay}" Minimum="5" Maximum="25" StepFrequency="1" Value="{x:Bind LowBattery, Mode=OneWay}" Tag="lowbat" ValueChanged="Slider_ValueChanged" Visibility="{x:Bind LowBatteryVisibility}" />
                                </Grid>
                            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,24,24">
            <Button Click="Back_Click" Padding="10,6" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Devices" />
                </StackPanel>
            </Button>
            <InfoBar x:Name="Gone" IsOpen="True" Visibility="Collapsed" IsClosable="False" Severity="Informational"
                     Message="This device isn't connected right now. Its settings are kept and applied when it's back." />
            <ContentControl x:Name="CardHost" ContentTemplate="{StaticResource FullCard}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>