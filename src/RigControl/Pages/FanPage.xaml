<Page
    x:Class="RigControl.Pages.FanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    xmlns:p="using:RigControl.Pages"
    xmlns:c="using:RigControl.Controls"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="FanSettings" x:DataType="p:FanEdit">
            <StackPanel Spacing="22">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:FanGlyph Width="64" Height="64" Rpm="{x:Bind Live.Rpm.Value, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Live.Name, Mode=OneWay}" Style="{StaticResource PageTitle}" Margin="0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Live.Device}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="{x:Bind local:Fmt.Int(Live.Rpm.Value), Mode=OneWay}" FontSize="30" FontWeight="SemiBold" /><Run Text=" rpm" Foreground="{StaticResource Muted}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}">
                            <Run Text="{x:Bind local:Fmt.Duty(Live.Duty.Value, Live.DutyKnown), Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Live.Mode, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Grid Height="4" CornerRadius="2" Background="#1AFFFFFF">
                    <Border CornerRadius="2" Background="{StaticResource AccentGradient}" HorizontalAlignment="Stretch">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{x:Bind local:Fmt.Fraction(Live.Duty.Value), Mode=OneWay}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <TextBlock Text="{x:Bind Live.Error, Mode=OneWay}" Foreground="{StaticResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind local:Fmt.ShowText(Live.Error), Mode=OneWay}" />

                <Grid ColumnSpacing="24" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="GENERAL" Style="{StaticResource Caption}" />
                    <TextBox Grid.Row="1" Header="Name" Text="{x:Bind Name, Mode=TwoWay}" PlaceholderText="{x:Bind Live.Channel.Name}" />
                    <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Controlled by RigControl" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Identify" Click="{x:Bind Identify}" ToolTipService.ToolTip="Stops this fan for 8 seconds so you can spot it" />
                        <DropDownButton Content="Swap with…" ToolTipService.ToolTip="Exchange name, curve and settings with another fan (fixes mixed-up identical controllers)">
                            <DropDownButton.Flyout>
                                <MenuFlyout Opening="SwapMenu_Opening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="SPEED" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <ComboBox Grid.Row="3" Header="Curve" HorizontalAlignment="Stretch" ItemsSource="{x:Bind CurveNames}" SelectedItem="{x:Bind Curve, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                    <ToggleSwitch Grid.Row="3" Grid.Column="1" Header="Fixed speed instead" IsOn="{x:Bind ManualOn, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                    <Slider Grid.Row="3" Grid.Column="2" Header="{x:Bind local:Fmt.Percent(ManualValue), Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind ManualValue, Mode=TwoWay}" IsEnabled="{x:Bind ManualOn, Mode=OneWay}" />

                    <TextBlock Grid.Row="4" Text="LIMITS" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <NumberBox Grid.Row="5" Header="Minimum %" Value="{x:Bind Min, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Row="5" Grid.Column="1" Header="Start % (spin-up kick)" Value="{x:Bind Start, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Row="5" Grid.Column="2" Header="Stop % (below this the fan stops; 0 = never)" Value="{x:Bind Stop, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Row="6" Header="Max step up per tick (%)" Value="{x:Bind StepUp, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Row="6" Grid.Column="1" Header="Max step down per tick (%)" Value="{x:Bind StepDown, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,24,24">
            <Button Click="Back_Click" Padding="10,6" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Dashboard" />
                </StackPanel>
            </Button>
            <ContentControl x:Name="Host" ContentTemplate="{StaticResource FanSettings}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
