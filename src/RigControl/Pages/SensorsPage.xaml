<Page
    x:Class="RigControl.Pages.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    Background="Transparent">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Sensors" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock x:Name="Count" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <AutoSuggestBox x:Name="Filter" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center" PlaceholderText="Filter" QueryIcon="Find" TextChanged="Filter_TextChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Groups" Padding="0,0,0,24">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:TempGroup">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Device}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{x:Bind}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:TempVm">
                                            <Grid ColumnSpacing="14" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                                                <Grid Grid.Column="1" Height="6" CornerRadius="3" Background="#14FFFFFF" VerticalAlignment="Center">
                                                    <Border CornerRadius="3" Background="{StaticResource AccentGradient}">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{x:Bind local:Fmt.TempFraction(Value.Value), Mode=OneWay}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{x:Bind local:Fmt.Temp(Value.Value), Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
