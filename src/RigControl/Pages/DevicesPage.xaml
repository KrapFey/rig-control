<Page
    x:Class="RigControl.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:RigControl.Pages"
    Background="Transparent">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <HyperlinkButton Content="Supported devices" Click="Supported_Click" ToolTipService.ToolTip="Every device and device family RigControl handles, searchable" />
                <Button x:Name="RescanButton" Click="Rescan_Click" ToolTipService.ToolTip="Look for devices again (one plugged in or woken up since RigControl started)" AutomationProperties.Name="Rescan">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Name="RescanText" Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Empty" Grid.Row="1" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,0">
            <FontIcon Glyph="&#xE772;" FontSize="40" Opacity="0.5" />
            <TextBlock Text="No configurable devices found yet." Opacity="0.7" HorizontalAlignment="Center" />
            <TextBlock Text="Supported so far: Razer, Logitech, SteelSeries and ASUS mice, Razer and Logitech keyboards, SteelSeries Apex Pro TKL (2023) and Gen 3 keyboards, and ~50 headsets (via HeadsetControl)." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="Body" Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Every device, with what matters now -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <ItemsRepeater x:Name="Tiles" Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="p:PeripheralCard">
                            <!-- ItemsRepeater doesn't set DataContext on its items; Tile_Click needs it -->
                            <Button Style="{StaticResource TileButton}" DataContext="{x:Bind}" Click="Tile_Click" AutomationProperties.Name="{x:Bind Name}">
                                <Border Style="{StaticResource Card}" Padding="12,10" BorderBrush="{x:Bind Stroke, Mode=OneWay}" BorderThickness="{x:Bind StrokeThickness, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="White" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Vital, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Visibility="{x:Bind BatteryVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind BatteryGlyph, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- The selected device's settings -->
            <Frame x:Name="Detail" Grid.Column="1" />
        </Grid>
    </Grid>
</Page>
