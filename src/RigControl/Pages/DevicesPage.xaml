<Page
    x:Class="RigControl.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:RigControl.Pages"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="Empty" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,0">
                <FontIcon Glyph="&#xE772;" FontSize="40" Opacity="0.5" />
                <TextBlock Text="No configurable devices found yet." Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock Text="Supported so far: Razer, Logitech and SteelSeries mice, SteelSeries Apex Pro TKL (2023) and Gen 3 keyboards, and ~50 headsets (via HeadsetControl)." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>

            <ItemsRepeater x:Name="Tiles">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="320" MinItemHeight="104" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="p:PeripheralCard">
                        <!-- ItemsRepeater doesn't set DataContext on its items; Tile_Tapped needs it -->
                        <Border Style="{StaticResource Card}" Padding="18" DataContext="{x:Bind}"
                                Tapped="Tile_Tapped" PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Vital, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Source}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Background="#1AFFFFFF" Visibility="{x:Bind BatteryVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind BatteryGlyph, Mode=OneWay}" FontSize="14" />
                                            <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
