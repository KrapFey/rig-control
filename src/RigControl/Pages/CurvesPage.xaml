<Page
    x:Class="RigControl.Pages.CurvesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:RigControl.Pages"
    xmlns:c="using:RigControl.Controls"
    Background="Transparent">

    <Grid ColumnSpacing="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Curves" Style="{StaticResource PageTitle}" Margin="0" />
            <TextBlock Text="Turn temperatures into fan speeds. Fans pick a curve on the Fans page." Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Curve list -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="CurveList" SelectionChanged="CurveList_SelectionChanged">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="-40" IsStaggeringEnabled="True" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="p:CurveItem">
                        <Grid Padding="4,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource AccentGradient}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Kind, Mode=OneWay}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Output, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <DropDownButton Content="New curve">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Graph (temperature → %)" Tag="Graph" Click="New_Click" />
                            <MenuFlyoutItem Text="Mix (combine curves)" Tag="Mix" Click="New_Click" />
                            <MenuFlyoutItem Text="Flat (fixed %)" Tag="Flat" Click="New_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="DeleteButton" Click="Delete_Click" ToolTipService.ToolTip="Delete curve">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <Border x:Name="EditorCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="22">
            <Border.Transitions>
                <TransitionCollection>
                    <ContentThemeTransition />
                </TransitionCollection>
            </Border.Transitions>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Header="Name" LostFocus="NameBox_LostFocus" />
                    <ComboBox x:Name="SourceBox" Grid.Column="1" Header="Temperature" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="SourceBox_SelectionChanged" />
                    <NumberBox x:Name="DeadbandBox" Grid.Column="2" Header="Deadband °C" Minimum="0" Maximum="20" SpinButtonPlacementMode="Compact" ValueChanged="Tuning_ValueChanged" ToolTipService.ToolTip="Ignore temperature changes smaller than this" />
                    <NumberBox x:Name="ResponseBox" Grid.Column="3" Header="Response s" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact" ValueChanged="Tuning_ValueChanged" ToolTipService.ToolTip="A change must last this long before fans react" />
                    <ComboBox x:Name="MixBox" Grid.Column="1" Header="Combine with" HorizontalAlignment="Stretch" SelectionChanged="MixBox_SelectionChanged" Visibility="Collapsed">
                        <x:String>Max</x:String>
                        <x:String>Min</x:String>
                        <x:String>Average</x:String>
                    </ComboBox>
                </Grid>

                <c:CurveEditor x:Name="Editor" Grid.Row="1" />

                <StackPanel x:Name="MixPanel" Grid.Row="1" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="INPUT CURVES" Style="{StaticResource Caption}" />
                    <ItemsControl x:Name="MixInputs" />
                </StackPanel>

                <StackPanel x:Name="FlatPanel" Grid.Row="1" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="FlatText" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource AccentGradient}" />
                    <Slider x:Name="FlatSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="FlatSlider_ValueChanged" />
                </StackPanel>

                <StackPanel x:Name="Empty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE9D9;" FontSize="40" Opacity="0.5" />
                    <TextBlock Text="No curves yet. Create one, or bring over your FanControl setup." Opacity="0.7" HorizontalAlignment="Center" />
                    <Button x:Name="ImportButton" Content="Import FanControl setup" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
