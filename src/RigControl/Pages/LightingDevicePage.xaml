<Page
    x:Class="RigControl.Pages.LightingDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    Background="Transparent">

    <!-- One lighting device and every setting it has, opened from its card on the Lighting page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,24,24">
            <Button Click="Back_Click" Padding="10,6" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Lighting" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="Missing" Text="This device isn't connected right now." Opacity="0.7" Visibility="Collapsed" />

            <StackPanel x:Name="Body" Spacing="18">
                <!-- Header -->
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGradient}">
                        <FontIcon Glyph="{x:Bind Card.Glyph, Mode=OneWay}" FontSize="26" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Card.Name, Mode=OneWay}" Style="{StaticResource PageTitle}" Margin="0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Card.Detail, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="Identify_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Pulses this device white for 4 seconds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                            <TextBlock Text="Identify" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- What the LEDs show right now -->
                <Grid Height="30">
                    <Border Background="{x:Bind Card.Preview, Mode=OneWay}" CornerRadius="15" Opacity="0.4" Margin="8,8,8,-6" />
                    <Border Background="{x:Bind Card.Preview, Mode=OneWay}" CornerRadius="10" Margin="0,2" BorderBrush="#26FFFFFF" BorderThickness="1" />
                </Grid>

                <!-- What it shows -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="SHOWS" Style="{StaticResource Caption}" />
                        <ComboBox x:Name="SourceBox" MinWidth="320" ItemsSource="{x:Bind Card.Options, Mode=OneWay}" SelectedIndex="{x:Bind Card.Selected, Mode=TwoWay}"
                                  AutomationProperties.Name="What this device shows" />
                        <TextBlock x:Name="SourceNote" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <!-- A built-in effect: the settings the device offers for it -->
                        <StackPanel Spacing="12" Visibility="{x:Bind Card.HardwareVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind Card.ColorVisibility, Mode=OneWay}">
                                <Button Width="44" Height="32" Padding="0" CornerRadius="8" Background="{x:Bind Card.ColorBrush, Mode=OneWay}" Click="PickColor_Click" ToolTipService.ToolTip="Colour" />
                                <TextBlock Text="{x:Bind Card.ColorText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Grid ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Slider Header="Speed" Minimum="0" Maximum="100" Value="{x:Bind Card.Speed, Mode=TwoWay}" Visibility="{x:Bind Card.SpeedVisibility, Mode=OneWay}" />
                                <Slider Grid.Column="1" Header="Brightness" Minimum="0" Maximum="100" Value="{x:Bind Card.Brightness, Mode=TwoWay}" Visibility="{x:Bind Card.BrightnessVisibility, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <!-- Its own effect -->
                        <local:EffectEditor x:Name="Editor" Visibility="{x:Bind Card.OwnEffectVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Layout, zones and single LEDs -->
                <Border Style="{StaticResource Card}" Padding="22" Visibility="{x:Bind Card.ZonesVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="LAYOUT AND ZONES" Style="{StaticResource Caption}" />
                        <ContentControl x:Name="ZonesHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
