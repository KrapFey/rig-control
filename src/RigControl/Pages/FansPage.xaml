<Page
    x:Class="RigControl.Pages.FansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RigControl"
    xmlns:p="using:RigControl.Pages"
    xmlns:c="using:RigControl.Controls"
    Background="Transparent">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Fans" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock Text="Each fan follows a curve, a fixed speed, or stays on the hardware's own control." Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowEmpty" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="Showing empty headers" OffContent="Hiding empty headers" Toggled="ShowEmpty_Toggled" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="1"
            SelectionMode="None"
            Padding="0,0,0,24">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="60" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="p:FanEdit">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind Expanded, Mode=TwoWay}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStroke}" CornerRadius="14">
                        <Expander.Header>
                            <Grid ColumnSpacing="14" Padding="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:FanGlyph Rpm="{x:Bind Live.Rpm.Value, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Live.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Live.Device}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Live.Mode, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind local:Fmt.Duty(Live.Duty.Value, Live.DutyKnown), Mode=OneWay}" Width="44" TextAlignment="Right" />
                                    <TextBlock Width="84" TextAlignment="Right">
                                        <Run Text="{x:Bind local:Fmt.Int(Live.Rpm.Value), Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" rpm" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <Grid ColumnSpacing="24" RowSpacing="14" Padding="4,4,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox Header="Name" Text="{x:Bind Name, Mode=TwoWay}" PlaceholderText="{x:Bind Live.Channel.Name}" />
                            <ToggleSwitch Grid.Column="1" Header="Controlled by RigControl" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="Identify" Click="{x:Bind Identify}" ToolTipService.ToolTip="Stops this fan for 8 seconds so you can spot it" />
                                <DropDownButton Content="Swap with…" Tag="{x:Bind}" ToolTipService.ToolTip="Exchange name, curve and settings with another fan (fixes mixed-up identical controllers)">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Opening="SwapMenu_Opening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>

                            <ComboBox Grid.Row="1" Header="Curve" HorizontalAlignment="Stretch" ItemsSource="{x:Bind CurveNames}" SelectedItem="{x:Bind Curve, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Fixed speed instead" IsOn="{x:Bind ManualOn, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}" />
                            <Slider Grid.Row="1" Grid.Column="2" Header="{x:Bind local:Fmt.Percent(ManualValue), Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind ManualValue, Mode=TwoWay}" IsEnabled="{x:Bind ManualOn, Mode=OneWay}" />

                            <NumberBox Grid.Row="2" Header="Minimum %" Value="{x:Bind Min, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Row="2" Grid.Column="1" Header="Start % (spin-up kick)" Value="{x:Bind Start, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Row="2" Grid.Column="2" Header="Stop % (below this the fan stops; 0 = never)" Value="{x:Bind Stop, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Row="3" Header="Max step up per tick (%)" Value="{x:Bind StepUp, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Row="3" Grid.Column="1" Header="Max step down per tick (%)" Value="{x:Bind StepDown, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Bind Live.Error, Mode=OneWay}" Foreground="{StaticResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" Visibility="{x:Bind local:Fmt.ShowText(Live.Error), Mode=OneWay}" />
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
