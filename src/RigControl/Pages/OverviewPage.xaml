<Page
    x:Class="RigControl.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:RigControl.Controls"
    xmlns:local="using:RigControl"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- No wider than 1400: on a big screen the cards stretched until their numbers sat far from their names -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="1400" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="16" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="30" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel>
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="Notices" Spacing="8" />

            <!-- The readings that matter most, with their last 3 minutes -->
            <Grid x:Name="Stats" ColumnSpacing="14">
                <Button x:Name="CpuTile" Style="{StaticResource TileButton}" Click="Sensors_Click" AutomationProperties.Name="CPU temperature" ToolTipService.ToolTip="Every temperature sensor (Cooling, Sensors)">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuRange" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTipService.ToolTip="Lowest and highest in the last 3 minutes" />
                            </Grid>
                            <TextBlock x:Name="CpuValue" Style="{StaticResource StatValue}" />
                            <TextBlock x:Name="CpuName" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            <c:Sparkline x:Name="CpuLine" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="GpuTile" Style="{StaticResource TileButton}" Click="Sensors_Click" AutomationProperties.Name="GPU temperature" ToolTipService.ToolTip="Every temperature sensor (Cooling, Sensors)">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="GPU" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuRange" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTipService.ToolTip="Lowest and highest in the last 3 minutes" />
                            </Grid>
                            <TextBlock x:Name="GpuValue" Style="{StaticResource StatValue}" />
                            <TextBlock x:Name="GpuName" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            <c:Sparkline x:Name="GpuLine" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="LiquidTile" Style="{StaticResource TileButton}" Click="Sensors_Click" AutomationProperties.Name="Liquid temperature" ToolTipService.ToolTip="Every temperature sensor (Cooling, Sensors)">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="LIQUID" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="LiquidRange" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTipService.ToolTip="Lowest and highest in the last 3 minutes" />
                            </Grid>
                            <TextBlock x:Name="LiquidValue" Style="{StaticResource StatValue}" />
                            <TextBlock x:Name="LiquidName" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            <c:Sparkline x:Name="LiquidLine" Margin="0,8,0,0" MinSpan="5" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="AirTile" Style="{StaticResource TileButton}" Click="OpenCooling_Click" AutomationProperties.Name="Airflow" ToolTipService.ToolTip="The curves that set the fans (Cooling)">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="AIRFLOW" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="AirRange" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTipService.ToolTip="Lowest and highest in the last 3 minutes" />
                            </Grid>
                            <TextBlock x:Name="AirValue" Style="{StaticResource StatValue}" />
                            <TextBlock x:Name="AirText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            <c:Sparkline x:Name="AirLine" Margin="0,8,0,0" MinSpan="20" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
            <TextBlock Text="Lines and ranges show the last 3 minutes." Style="{StaticResource Caption}" Margin="2,-8,0,0" />

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Cooling, curve by curve -->
                <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Cooling" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="CoolingProfileBox" MinWidth="150" Visibility="Collapsed" SelectionChanged="CoolingProfileBox_SelectionChanged"
                                          AutomationProperties.Name="Cooling profile" ToolTipService.ToolTip="Cooling profile" />
                            </StackPanel>
                            <HyperlinkButton Content="Open" HorizontalAlignment="Right" Click="OpenCooling_Click" AutomationProperties.Name="Open cooling" />
                        </Grid>
                        <StackPanel x:Name="CurveRows" Spacing="2" />
                        <TextBlock x:Name="CoolingNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <!-- Lighting: the effect, every device's colours now, and the switch -->
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lighting" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="LightingProfileBox" Grid.Column="1" MinWidth="130" MaxWidth="190" HorizontalAlignment="Left" Visibility="Collapsed" SelectionChanged="LightingProfileBox_SelectionChanged"
                                          AutomationProperties.Name="Lighting profile" ToolTipService.ToolTip="Lighting profile" />
                                <ToggleSwitch x:Name="LightingSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="LightingSwitch_Toggled"
                                              AutomationProperties.Name="Lighting on" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="3" Content="Open" Click="OpenLighting_Click" AutomationProperties.Name="Open lighting" />
                            </Grid>
                            <TextBlock x:Name="LightingText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <Grid x:Name="Swatches" ColumnSpacing="4" Height="12" />
                        </StackPanel>
                    </Border>

                    <!-- Mice, keyboards, headsets -->
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Devices" Style="{StaticResource CardTitle}" />
                                <HyperlinkButton Content="Open" HorizontalAlignment="Right" Click="OpenDevices_Click" AutomationProperties.Name="Open devices" />
                            </Grid>
                            <StackPanel x:Name="DeviceRows" Spacing="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Every fan that's plugged in: its speed now -->
            <Border x:Name="FansCard" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Fans" Style="{StaticResource CardTitle}" />
                        <HyperlinkButton Content="Open" HorizontalAlignment="Right" Click="OpenCooling_Click" AutomationProperties.Name="Open cooling" />
                    </Grid>
                    <ItemsRepeater x:Name="FanTiles">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="230" MinColumnSpacing="16" MinRowSpacing="2" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:FanVm">
                                <Button Style="{StaticResource TileButton}" CornerRadius="6" Click="Fan_Click" DataContext="{x:Bind}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Caption, Mode=OneWay}">
                                    <Grid Padding="6" ColumnSpacing="10" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <c:FanGlyph Width="20" Height="20" Rpm="{x:Bind Rpm.Value, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind local:Fmt.Rpm(Rpm.Value), Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind local:Fmt.Duty(Duty.Value, DutyKnown), Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
