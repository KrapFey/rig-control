<Page
    x:Class="RigControl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />

            <TextBlock Text="GENERAL" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                        <TextBlock Text="Starts in the tray at logon, with admin rights and no UAC prompt (a scheduled task)." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoStart" Grid.Column="1" Toggled="AutoStart_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tray icon shows" FontWeight="SemiBold" />
                        <TextBlock Text="A live reading on the taskbar. Clicking the icon opens RigControl; right-clicking switches the cooling or lighting profile." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="TrayShowsBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="TrayShows_Changed" AutomationProperties.Name="Tray icon shows">
                        <x:String>RigControl logo</x:String>
                        <x:String>CPU temperature</x:String>
                        <x:String>GPU temperature</x:String>
                        <x:String>Airflow (average fan speed)</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dark while Windows is locked" FontWeight="SemiBold" />
                        <TextBlock Text="Every light RigControl drives goes off when you lock the PC and comes back when you unlock it." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DarkLocked" Grid.Column="1" Toggled="DarkLocked_Toggled" AutomationProperties.Name="Lights off while Windows is locked" />
                </Grid>
            </Border>
            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Low battery" FontWeight="SemiBold" />
                        <TextBlock Text="Tells you when a mouse, keyboard or headset falls to this charge (%). 0 turns it off." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="BatteryAlert" Grid.Column="1" Width="140" Minimum="0" Maximum="50" SmallChange="5" SpinButtonPlacementMode="Compact" VerticalAlignment="Center"
                               ValueChanged="Alert_ValueChanged" AutomationProperties.Name="Low battery notification, percent" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CPU or graphics card hot" FontWeight="SemiBold" />
                        <TextBlock Text="Tells you when either stays at this temperature (°C) or above for 20 seconds. 0 turns it off." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="HotAlert" Grid.Column="1" Width="140" Minimum="0" Maximum="110" SmallChange="5" SpinButtonPlacementMode="Compact" VerticalAlignment="Center"
                               ValueChanged="Alert_ValueChanged" AutomationProperties.Name="Hot notification, degrees Celsius" />
                </Grid>
            </Border>
            <TextBlock Text="PROFILES THAT FOLLOW APPS" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="Switch profiles while a program runs" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="While a program listed here is running, its cooling and lighting profiles are in use; when it closes, the ones from before come back. With several running, the first in the list wins." />
                    </StackPanel>
                    <StackPanel x:Name="RulesList" Spacing="8" />
                    <Button Click="AddRule_Click" AutomationProperties.Name="Add a program" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add a program" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Text="FANS AND SENSORS" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Update interval" FontWeight="SemiBold" />
                        <TextBlock Text="How often sensors are read and fans adjusted." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ComboBox x:Name="Interval" Grid.Column="1" Width="140" SelectionChanged="Interval_SelectionChanged">
                        <x:String>0.5 s</x:String>
                        <x:String>1 s</x:String>
                        <x:String>2 s</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border x:Name="DriversCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="Fan controller drivers" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Each controller uses RigControl's built-in driver. If one misbehaves, switch it to liquidctl's driver. Fan names, curves and limits move with it; RigControl restarts to apply." />
                    </StackPanel>
                    <StackPanel x:Name="DriversList" Spacing="8" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Import from FanControl" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImportHint" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ImportButton" Grid.Column="1" Content="Import…" Click="Import_Click" />
                </Grid>
            </Border>
            <TextBlock Text="UPDATES" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Updates" FontWeight="SemiBold" />
                            <TextBlock Text="Asks GitHub for a newer release at start and once a day. Nothing about you or your PC is sent." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoUpdate" Grid.Column="1" Toggled="AutoUpdate_Toggled" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckNow" Content="Check now" Click="CheckNow_Click" />
                        <Button x:Name="InstallUpdate" Content="Update" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="InstallUpdate_Click" />
                        <HyperlinkButton x:Name="ReleaseNotes" Content="What's new" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="ABOUT" Style="{StaticResource Caption}" Margin="2,14,0,2" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AboutTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="Supported_Click" AutomationProperties.Name="Supported devices" ToolTipService.ToolTip="Every device and device family RigControl handles, searchable">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                <TextBlock Text="Supported devices" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                        GPL-3.0-or-later. Sensors and motherboard/GPU fans: LibreHardwareMonitor (MPL-2.0) via PawnIO.
                        NZXT HUE 2 fan protocol: ported from liquidctl (GPL-3.0-or-later). USB HID: HidSharp (Apache-2.0).
                        Tray: H.NotifyIcon (MIT).
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings folder" FontWeight="SemiBold" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Click="OpenFolder_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
