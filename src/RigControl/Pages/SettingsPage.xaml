<Page
    x:Class="RigControl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Padding="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                        <TextBlock Text="Starts in the tray at logon, with admin rights and no UAC prompt (a scheduled task)." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoStart" Grid.Column="1" Toggled="AutoStart_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <StackPanel>
                        <TextBlock Text="Taskbar" FontWeight="SemiBold" />
                        <TextBlock Text="The tray icon can show a live reading; clicking it opens a mini dashboard (double-click opens the full app)." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TrayShowsBox" Header="Tray icon shows" MinWidth="220" SelectionChanged="TrayShows_Changed">
                            <x:String>RigControl logo</x:String>
                            <x:String>CPU temperature</x:String>
                            <x:String>GPU temperature</x:String>
                            <x:String>Airflow (average fan speed)</x:String>
                        </ComboBox>
                        <ToggleSwitch x:Name="TrayPopupSwitch" Grid.Column="1" Header="Clicking the icon" OnContent="Opens the mini dashboard" OffContent="Opens the full app" Toggled="TrayPopup_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Updates" FontWeight="SemiBold" />
                            <TextBlock Text="Asks GitHub for a newer release at start and once a day. Nothing about you or your PC is sent." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoUpdate" Grid.Column="1" Toggled="AutoUpdate_Toggled" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckNow" Content="Check now" Click="CheckNow_Click" />
                        <Button x:Name="InstallUpdate" Content="Update" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="InstallUpdate_Click" />
                        <HyperlinkButton x:Name="ReleaseNotes" Content="What's new" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Update interval" FontWeight="SemiBold" />
                        <TextBlock Text="How often sensors are read and fans adjusted." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ComboBox x:Name="Interval" Grid.Column="1" Width="140" SelectionChanged="Interval_SelectionChanged">
                        <x:String>0.5 s</x:String>
                        <x:String>1 s</x:String>
                        <x:String>2 s</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <Border x:Name="DriversCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="Fan controller drivers" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Each controller uses RigControl's built-in driver. If one misbehaves, switch it to liquidctl's driver. Fan names, curves and limits move with it; RigControl restarts to apply." />
                    </StackPanel>
                    <StackPanel x:Name="DriversList" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Import from FanControl" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImportHint" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ImportButton" Grid.Column="1" Content="Import…" Click="Import_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings folder" FontWeight="SemiBold" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AboutTitle" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                        GPL-3.0-or-later. Sensors and motherboard/GPU fans: LibreHardwareMonitor (MPL-2.0) via PawnIO.
                        NZXT HUE 2 fan protocol: ported from liquidctl (GPL-3.0-or-later). USB HID: HidSharp (Apache-2.0).
                        Tray: H.NotifyIcon (MIT).
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
