<Application
    x:Class="RigControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AccentA">#7C5CFF</Color>
            <Color x:Key="AccentB">#00D4FF</Color>
            <Color x:Key="Hot">#FF5C7A</Color>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource AccentA}" />
                <GradientStop Offset="1" Color="{StaticResource AccentB}" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardStroke" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="Muted" Color="#99FFFFFF" />

            <!-- override the system accent so every control matches -->
            <Color x:Key="SystemAccentColor">#7C5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#9479FF</Color>
            <Color x:Key="SystemAccentColorLight2">#AC97FF</Color>
            <Color x:Key="SystemAccentColorLight3">#C4B5FF</Color>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
